import numpy

n, m, p = map(int, input().split())

array_1 = []
for _ in range(n):
    array_1.append(list(map(int, input().split())))

array_2 = []
for _ in range(m):
    array_2.append(list(map(int, input().split())))

arr1 = numpy.array(array_1)
arr2 = numpy.array(array_2)

print(numpy.concatenate((arr1, arr2), axis=0))
