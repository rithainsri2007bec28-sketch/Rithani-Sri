import re

def is_valid_uid(uid):
    if len(uid) != 10 or not uid.isalnum():
        return False
    if len(set(uid)) != 10:
        return False
    if len(re.findall(r'[A-Z]', uid)) < 2:
        return False
    if len(re.findall(r'[0-9]', uid)) < 3:
        return False
    return True

t = int(input())
for _ in range(t):
    s = input().strip()
    if is_valid_uid(s):
        print("Valid")
    else:
        print("Invalid")
