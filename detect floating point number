import re

def is_valid_float():
    # Read the number of test cases
    for _ in range(int(input())):
        s = input().strip()
        pattern = r'^[+-]?[0-9]*\.[0-9]+$'
        if re.match(pattern, s):
            print("True")
        else:
            print("False")

if __name__ == '__main__':
    is_valid_float()
